# Google Gemini API key used to authenticate requests to Gemma 4 and the Gemini Embedding model. Get yours free at https://aistudio.google.com
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional. Set both to turn on $ cost estimates (in the UI and in scripts/benchmark.py)
# instead of token counts alone. Look up current rates for gemma-4-26b-a4b-it at
# https://ai.google.dev/gemini-api/docs/pricing — left unset, cost is simply not computed.
GEMMA_INPUT_PRICE_PER_1M=
GEMMA_OUTPUT_PRICE_PER_1M=
